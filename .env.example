FUKO_DATABASE_URL=postgresql://fuko:secret@localhost:5432/fuko

# Embeddings (any OpenAI-compatible /embeddings endpoint). The vector column
# is sized to whatever the model returns (probed at startup), so FUKO_EMBED_DIM
# is only a fallback used when the probe can't run.
#   - Ollama:   base http://localhost:11434/v1, model bge-m3 (dim 1024)
#   - z.ai:     base https://api.z.ai/api/paas/v4, reuse your GLM key (verify the
#               embedding model name + dim against the live API)
#   - bigmodel: base https://open.bigmodel.cn/api/paas/v4, model embedding-3 (dim 2048)
#   - OpenAI:   base https://api.openai.com/v1, model text-embedding-3-small (dim 1536)
#
# FUKO_EMBED_MODEL and FUKO_EMBED_QUERY_PREFIX have to move TOGETHER. The model
# is also the provenance marker for the stored vectors -- change it and the
# whole knowledge base is re-embedded on the next startup -- while the prefix
# decides what the *query* side is embedded as. Only the model is tracked, so a
# prefix that does not match it degrades retrieval with nothing to show for it.
# The code default is Qwen3-Embedding-0.6B, which is asymmetric and carries a
# task instruction; a symmetric model such as bge-m3 needs the prefix cleared,
# which is what this file (and docker/runner-compose.yml, and CI) does.
FUKO_EMBED_BASE_URL=http://localhost:11434/v1
FUKO_EMBED_MODEL=bge-m3
FUKO_EMBED_QUERY_PREFIX=
# FUKO_EMBED_API_KEY=          # set for remote providers (e.g. your GLM/z.ai key)
# FUKO_EMBED_DIM=1024          # fallback dim if the startup probe can't reach the model

# Sidecar:
# FUKO_AUTH_TOKEN=optional-shared-secret-for-write-endpoints
# FUKO_TOP_K=6
# FUKO_HOST=0.0.0.0
# FUKO_PORT=8000
# Agentic reviewer:
# FUKO_TRANSCRIPT_DIR=/var/lib/fuko/transcripts
#                              # where agentic session transcripts are written
#                              # (one scrubbed NDJSON file per branch per push).
#                              # UNSET = capture off, which is the default: the
#                              # corpus is kept forever, so the destination is a
#                              # deliberate choice. See docs/agentic-reviewer.md.
# FUKO_INGEST_MAX_NEW=10       # new learnings embedded per /ingest-threads call;
#                              # the sweep re-posts until the sidecar reports
#                              # remaining=0, so this bounds request time, not
#                              # how much a sweep can ingest. Lower it if a slow
#                              # embedder still trips the caller's timeout.
