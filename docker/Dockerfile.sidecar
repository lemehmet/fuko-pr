FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY sidecar ./sidecar
COPY migrations ./migrations

# `.[s3]` rather than the bare project: the s3/r2 transcript store (#238) is
# the headline configuration in docs/deployment.md, and boto3 is imported
# lazily inside the request path -- so without the extra the documented
# deployment fails per upload with a ModuleNotFoundError rather than at start.
# The `file` backend and the unconfigured default need nothing extra.
RUN pip install --no-cache-dir ".[s3]"

EXPOSE 8000

CMD ["python", "-m", "sidecar.cli", "serve"]
