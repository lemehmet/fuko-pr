# fuko-pr per-repo config. Copy to `.fuko.toml` in your app repo and commit it.
# Secrets never live here — each provider preset declares the env var for its key
# (supplied as a CI secret). See docs/design.md for the full schema.

[review]
backend = "pr-agent"            # review engine (driver)
tools = ["review", "improve"]   # PR-Agent tools to run
# PR-Agent runs from its Docker image (it is not pip-installable). Defaults to
# codiumai/pr-agent:latest; point at a pinned tag in your own registry once you
# publish one (e.g. ghcr.io/OWNER/pr-agent:0.36.1).
# image = "ghcr.io/OWNER/pr-agent:0.36.1"
# Extra `docker run` args, e.g. host networking so the container can reach a
# host Ollama on Linux: docker_extra_args = ["--add-host", "host.docker.internal:host-gateway"]
# docker_extra_args = []

# One unified [[review.models]] list drives everything. Each entry is a model on
# a provider preset, plus a role:
#
#   role = "active" (default) — reviews EVERY PR. One active is a plain solo
#   review; two or more actives A/B the PR, each branch posting its own fresh
#   summary under a "🤖 fuko A/B — model <id>" header. `describe` is
#   auto-disabled in A/B mode (a PR has one description).
#
#   role = "backup" — never starts a review. A shared failover target every
#   active falls back to when its provider throttles (429/quota/overload/
#   timeout). A throttle trips the provider's breaker (the cooldown is global
#   per provider and shared across repos, since the API key is shared;
#   persisted in the sidecar's Postgres); a non-throttle error fails fast.
#   Entry order = failover priority.
#
# Known presets: zai-coding, ollama, ollama-cloud, openrouter, anthropic, openai.
#
# Concurrent A/B (per-branch identities): give EVERY active a `token_env` whose
# env var resolves to a distinct GitHub actor (e.g. two GitHub Apps), and the
# branches run concurrently — each posts and edits its own comments under its
# own token (distinct throttle buckets, author separation). If any active lacks
# a distinct token the whole run falls back to sequential under the base token.
# Wire the tokens in the workflow (one `create-github-app-token` step per App).
#
# A provider whose max_context can't hold the job (diff + knowledge estimate) is
# demoted to last resort. max_model_tokens overrides PR-Agent's per-review token
# budget — the cap it applies BEFORE the model's window (it defaults to 32000
# and would otherwise prune big diffs); the GLM presets default it to 512000.
#
# cooldown_seconds = 300         # how long a throttled provider stays skipped

[[review.models]]
provider = "zai-coding"         # key from env ZAI_KEY
name = "glm-5.2"
max_context = 1000000
# token_env = "FUKO_GITHUB_TOKEN_A"   # post under the App minted into this env var
# max_model_tokens = 256000     # optional: cap below the preset's 512000 default

# [[review.models]]
# provider = "openrouter"       # any OpenRouter model, key from OPENROUTER_KEY
# name = "deepseek/deepseek-v4-pro"   # vendor/model id; append :nitro to route by throughput
# max_context = 1048576
# token_env = "FUKO_GITHUB_TOKEN_B"   # distinct actor from A => the two run concurrently

# [[review.models]]
# provider = "ollama-cloud"     # same model via Ollama Cloud, key from OLLAMA_API_KEY
# name = "glm-5.2:cloud"
# max_context = 976000
# role = "backup"               # runs only when an active's provider throttles
#
# Running the SAME model on two providers (different keys/endpoints, so separate
# throttle buckets) is the simplest real failover. Use a shared Postgres
# knowledge base if several reviewers will WRITE to it — the server-free
# sqlite-vec store is single-writer (see docs/deployment.md).
#
# Deprecated but still parsed, mapped onto [[review.models]] with a stderr
# nudge: [review.model] (one active), [[review.providers]] (first entry active,
# rest backups), [[review.compare]] (all active).

[knowledge]
store = "postgres"              # postgres | sqlite-vec

# When store = "sqlite-vec", the knowledge file lives in object storage:
# [knowledge.object_store]
# backend = "s3"                # s3 | r2 | file
# bucket = "my-fuko-kb"
# key = "owner/repo.db"
# creds_env_prefix = "FUKO_S3"  # reads FUKO_S3_ACCESS_KEY_ID, FUKO_S3_SECRET_ACCESS_KEY

[embedding]
# Self-hosted runners: local Ollama (offline default). SaaS runners: prefer a
# remote, non-OpenAI provider (e.g. Voyage, Jina, bigmodel) — see docs.
provider = "ollama"
model = "bge-m3"
base_url = "http://localhost:11434/v1"
