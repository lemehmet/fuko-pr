# fuko-pr per-repo config. Copy to `.fuko.toml` in your app repo and commit it.
# Secrets never live here — each provider preset declares the env var for its key
# (supplied as a CI secret). See docs/design.md for the full schema.

[review]
backend = "pr-agent"            # review engine (driver): pr-agent | agentic
                                # (agentic = fuko's own checkout-based reviewer,
                                # headless Claude Code; see docs/agentic-reviewer.md)
tools = ["review", "improve"]   # PR-Agent tools to run
# PR-Agent runs from its Docker image (it is not pip-installable). Defaults to
# codiumai/pr-agent:latest; point at a pinned tag in your own registry once you
# publish one (e.g. ghcr.io/OWNER/pr-agent:0.36.1).
# image = "ghcr.io/OWNER/pr-agent:0.36.1"
# Extra `docker run` args, e.g. host networking so the container can reach a
# host Ollama on Linux: docker_extra_args = ["--add-host", "host.docker.internal:host-gateway"]
# docker_extra_args = []

# One unified [[review.models]] list drives everything. Each entry is a model on
# a provider preset, plus a role:
#
#   role = "active" (default) — reviews EVERY PR. One active is a plain solo
#   review; two or more actives A/B the PR, each branch posting its own fresh
#   summary under a "🤖 fuko A/B — model <id>" header. `describe` is
#   auto-disabled in A/B mode (a PR has one description).
#
#   role = "trial" — runs on EVERY PR exactly like an active branch (its own
#   A/B branch + header + marked findings), but is tagged NON-gating: its
#   header shows "· trial" and its findings carry role="trial" in the signal
#   marker, so a consumer (e.g. the review-loop skill) surfaces its output for
#   evaluation WITHOUT waiting on it or blocking merge. Use it to vet a new
#   candidate model alongside the actives before promoting it to active. Wants a
#   `token_env` like an active (distinct identity / concurrent run).
#
#   role = "backup" — never starts a review. A shared failover target every
#   active/trial falls back to when its provider throttles (429/quota/overload/
#   timeout). A throttle trips the provider's breaker (the cooldown is global
#   per provider and shared across repos, since the API key is shared;
#   persisted in the sidecar's Postgres); a non-throttle error fails fast.
#   Entry order = failover priority.
#
# At least one entry must be role = "active" (trials and backups are non-gating,
# so a config with none would have nothing that gates).
#
# Known presets: zai-coding, ollama, ollama-cloud, lemonade, openrouter,
# prodia, anthropic, openai, qwen-anthropic. (lemonade = any Lemonade server,
# e.g. a LAN AMD box; OpenAI-compatible, no real auth — set LEMONADE_API_KEY
# to any non-empty value and point base_url at the host. prodia = a rented
# OpenAI-compatible GPU box, key from PRODIA_KEY; it has no default base_url,
# so each model entry must set base_url to the rental's endpoint.
# qwen-anthropic = QwenCloud's Anthropic-compatible Token Plan gateway, key
# from QWEN_TOKEN_PLAN_KEY (sk-sp-…): an `anthropic/`-family preset serving
# Qwen models, which is what admits a Qwen seat to the agentic backend —
# pair it with backend = "agentic" and auth = "api-key".)
#
# `auth` (agentic backend only): "auto" (default) | "api-key" | "subscription".
# api-key reads the preset's key env var; subscription runs as the runner's own
# logged-in Claude session and passes NO key. Pin it explicitly on a runner
# where a key is also present — an ambient key outranks the subscription and
# would silently bill per token. See docs/agentic-reviewer.md.
#
# Per-entry `backend` (driver): any [[review.models]] entry may set
#   backend = "pr-agent" | "agentic"
# to override [review].backend for THAT entry only; unset (None) inherits it, so a
# pr-agent-only config is unchanged. This is how one fleet mixes harnesses — the
# 2026-07-31 audit found same-pipeline instances correlate by construction, and
# harness diversity is the fix. An unknown name fails at config load, not mid-run.
# A promoted/rescued backup runs under the branch's backend unless it declares its
# own (a backup is only escalation-eligible when its backend matches the round's).
#
# Per-entry review steering: an optional `extra_instructions` string on any
# entry is prepended to the shared knowledge blob for THAT entry's runs only —
# use it to differentiate a fleet that would otherwise converge on the same
# findings (all entries share one context pipeline, so they correlate by
# construction). Entry-keyed: a promoted backup applies its own instructions,
# not the rescued branch's. Caution: a focus prompt implicitly deprioritizes
# everything outside the focus — prefer personas on trial/non-gating entries
# and keep gating actives general.
#
# Concurrent A/B (per-branch identities): give EVERY branch that runs — every
# active AND every trial (both start a branch) — a `token_env` whose env var
# resolves to a distinct GitHub actor (e.g. separate GitHub Apps), and the
# branches run concurrently — each posts and edits its own comments under its
# own token (distinct throttle buckets, author separation). If any active or
# trial lacks a distinct token the whole run falls back to sequential under the
# base token.
# Wire the tokens in the workflow (one `create-github-app-token` step per App).
#
# A provider whose max_context can't hold the job (diff + knowledge estimate) is
# demoted to last resort. max_model_tokens overrides PR-Agent's per-review token
# budget — the cap it applies BEFORE the model's window (it defaults to 32000
# and would otherwise prune big diffs); the GLM presets default it to 512000.
#
# cooldown_seconds = 300         # how long a throttled provider stays skipped

[[review.models]]
provider = "zai-coding"         # key from env ZAI_KEY
name = "glm-5.2"
max_context = 1000000
# token_env = "FUKO_GITHUB_TOKEN_A"   # post under the App minted into this env var
# max_model_tokens = 256000     # optional: cap below the preset's 512000 default

# [[review.models]]
# provider = "openrouter"       # any OpenRouter model, key from OPENROUTER_KEY
# name = "deepseek/deepseek-v4-pro"   # vendor/model id; append :nitro to route by throughput
# max_context = 1048576
# token_env = "FUKO_GITHUB_TOKEN_B"   # distinct actor from A => the two run concurrently

# [[review.models]]
# provider = "openrouter"       # a candidate model you want to evaluate live
# name = "meta/muse-spark-1.1"
# max_context = 1000000
# token_env = "FUKO_GITHUB_TOKEN_C"
# role = "trial"                # runs + surfaced for evaluation, but NON-gating
# backend = "agentic"           # override [review].backend for THIS entry only
# # Optional per-entry steering (see note above). Keep the opening """ bare:
# # a '#' after it would be part of the string, not a TOML comment.
# extra_instructions = """
# Review with an adversarial security and API-contract focus."""

# [[review.models]]
# provider = "ollama-cloud"     # same model via Ollama Cloud, key from OLLAMA_API_KEY
# name = "glm-5.2:cloud"
# max_context = 976000
# role = "backup"               # runs only when an active/trial's provider throttles
#
# Running the SAME model on two providers (different keys/endpoints, so separate
# throttle buckets) is the simplest real failover. Use a shared Postgres
# knowledge base if several reviewers will WRITE to it — the server-free
# sqlite-vec store is single-writer (see docs/deployment.md).
#
# Deprecated but still parsed, mapped onto [[review.models]] with a stderr
# nudge: [review.model] (one active), [[review.providers]] (first entry active,
# rest backups), [[review.compare]] (all active).

[knowledge]
store = "postgres"              # postgres | sqlite-vec

# When store = "sqlite-vec", the knowledge file lives in object storage:
# [knowledge.object_store]
# backend = "s3"                # s3 | r2 | file
# bucket = "my-fuko-kb"
# key = "owner/repo.db"
# creds_env_prefix = "FUKO_S3"  # reads FUKO_S3_ACCESS_KEY_ID, FUKO_S3_SECRET_ACCESS_KEY

[embedding]
# Self-hosted runners: local Ollama (offline default). SaaS runners: prefer a
# remote, non-OpenAI provider (e.g. Voyage, Jina, bigmodel) — see docs.
provider = "ollama"
model = "bge-m3"
base_url = "http://localhost:11434/v1"
